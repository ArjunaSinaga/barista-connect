# ==========================================================
# BaristaConnect - environment variables
# Copy this file to .env.local and fill in your real values.
# See SETUP.md for step-by-step instructions.
# ==========================================================

# From: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# Service role key (Settings -> API) — SERVER ONLY, untuk webhook pembayaran
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# From: https://dashboard.midtrans.com (Settings -> API Keys) — QRIS centang biru
MIDTRANS_SERVER_KEY=your-midtrans-server-key-here
MIDTRANS_IS_PRODUCTION=false

# From: https://build.nvidia.com/settings/api-keys (free credits)
NVIDIA_API_KEY=nvapi-your-key-here
# Any live model from https://build.nvidia.com (default shown)
NVIDIA_MODEL=nvidia/nemotron-3-nano-30b-a3b

# From: Kimi / ModelsLab (AI caption generation)
# MODELSLAB_TOKEN=your-token-here

# From: 21st.dev
# 21ST_API_KEY=21st_sk_...

# Backup LLM providers (lib/ai.js tries these in order):
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# CEREBRAS_API_KEY=csk-...
# CEREBRAS_MODEL=llama-3.3-70b
# BYTEZ_API_KEY=
# BYTEZ_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-exp

# Cron + site
# CRON_SECRET=random-long-secret
# NEXT_PUBLIC_SITE_URL=https://barista-connect.vercel.app
