{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["list"],
  "instructions": ["AGENTS.md", ".opencode/skills/task-observer/SKILL.md", ".21st/DESIGN.md"],
  "mcp": {
    "21st": {
      "type": "local",
      "command": ["npx", "-y", "@21st-dev/mcp"],
      "enabled": true,
      "env": { "21ST_API_KEY": "{env:21ST_API_KEY}" }
    }
  },
  "lsp": {
    "python": {
      "command": ["pyright-langserver", "--stdio"],
      "enabled": true,
      "extensions": [".py"]
    }
  }
}
