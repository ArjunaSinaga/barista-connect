{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    ".opencode/skills/task-observer/SKILL.md",
    ".21st/DESIGN.md"
  ],
  "mcp": {
    "21st": {
      "type": "remote",
      "url": "https://21st.dev/api/mcp",
      "enabled": true,
      "headers": {
        "x-api-key": "{env:21ST_API_KEY}"
      }
    }
  },
  "lsp": {
    "python": {
      "command": [
        "pyright-langserver",
        "--stdio"
      ],
      "enabled": true,
      "extensions": [
        ".py"
      ]
    }
  }
}
